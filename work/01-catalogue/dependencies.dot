// dependencies.dot -- claim dependency graph of claims.yaml (T1 catalogue, gate G0)
// An edge A -> B means: claim A depends on claim B (B must be discharged first).
// Generated from work/01-catalogue/claims.yaml; do not hand-edit, regenerate if claims.yaml changes.
// Acyclicity is checked mechanically at generation time (DFS with colour marking); see reports/T1-report.md.
// Node colour = status tag: M green, M? brown, S red, C amber, E blue, D grey.
// Shape: ellipse = theorem/lemma/proposition/corollary, box = definition/remark, egg = numbered equation,
//        note = observed execution, parallelogram = assumption/premise or interface equation.
digraph mub6_claims {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=10, compound=true, nodesep=0.2, ranksep=0.8];
  node [fontname="Helvetica", fontsize=9, shape=ellipse, style=filled, fillcolor=white];
  edge [color="#555555", arrowsize=0.6];
  subgraph cluster_1 {
    label="section 1"; fontsize=11; style=dashed; color="#999999";
    "thm-1.1" [label="thm-1.1\nComputer-assisted: no four MUBs in dim..", fillcolor="#f9a82522", color="#f9a825", shape="ellipse"];
